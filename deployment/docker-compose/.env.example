# Copy to .env in this directory and edit. Never commit real secrets.
# Used by docker-compose-build.yml (local builds) and docker-compose-prod.yml (Docker Hub images).

# Public URL of the web UI (scheme + host + port, no path). Must match what users type in the browser.
# Example when publishing port 8080 on localhost:
CLIENT_ORIGIN=http://localhost:8080

# Optional: override session cookie Secure (see server/.env.example). Use false for local HTTP without TLS.
# SESSION_COOKIE_SECURE=false

# Required for full-stack Compose (16+ characters). If empty, `npm run compose:build` / `compose:prod` runs
# `node deployment/docker-compose/ensure-env.mjs` first and fills this automatically on the host
# (same file the api container loads via env_file — stable across rebuilds). You can also run:
#   openssl rand -base64 32
# and paste manually. Do not commit .env.
JWT_SECRET=

# Admin site bootstrap credentials for /admin (must be changed immediately after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Base32 TOTP secret for admin 2FA (example only; replace in production)
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Optional: host port mapped to nginx (default 8080)
HTTP_PORT=8080

# --- docker-compose-build.yml (local image build) ---
# Optional: baked into API + web images and passed to the API container. Defaults to "dev" when unset.
# APP_VERSION=v1.4.0

# --- docker-compose-prod.yml (Docker Hub images) ---
# Image tag for api + web (must match tags you pushed). Defaults to 1.0.
# IMAGE_TAG=v1.4.0
# Optional: Docker Hub user/org (defaults to maxwayne).
# DOCKERHUB_USERNAME=maxwayne
# Optional: override displayed version in GET /health / UI; defaults to IMAGE_TAG then 1.0.
# APP_VERSION=v1.4.0

# PostgreSQL (defaults match docker-compose service names)
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense_tracker

# OAuth — leave empty if not using single sign-on
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=
OAUTH_GITLAB_BASE_URL=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=

# Optional: dedicated key for encrypting bank access tokens at rest.
# If blank, JWT_SECRET is used.
BANK_TOKEN_ENCRYPTION_KEY=
