# Optional: release string returned by GET /health and used when the web UI fetches /health in dev.
# In Docker, prefer setting APP_VERSION at image build (see deployment/docker/Dockerfile.api) or in Compose.
# APP_VERSION=1.0.0

# TCP port where the Express HTTP server listens.
PORT=4000

# PostgreSQL connection string used by the API (host, database name, user, password).
DATABASE_URL=postgresql://expense:expense@localhost:5432/expense_tracker

# Redis connection string for optional report caching. If unset, reports are not cached in Redis.
REDIS_URL=redis://localhost:6379

# Secret key used to sign JSON Web Tokens. Change this in production to a long random string.
JWT_SECRET=change-me-in-production-use-long-random-string

# Default admin bootstrap account for /admin. Must be changed immediately after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Base32 TOTP secret used for 2FA (example only; replace with your own).
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Base URL of the single-page application as seen in the browser: scheme, host, and port only, with no path and no trailing slash.
# Comma-separated list is allowed for multiple dev origins. Required for browser access in production (CORS refuses unknown Origins when unset).
# Used for Cross-Origin Resource Sharing configuration and for OAuth redirect URLs after login.
CLIENT_ORIGIN=http://localhost:5173

# Optional: force the user session cookie "Secure" flag (true/false/1/0/yes/no).
# When unset, server/src/sessionCookie.js infers it: non-production uses non-Secure cookies; in production,
# http://localhost or http://127.0.0.1 in CLIENT_ORIGIN uses non-Secure for local HTTP; otherwise Secure follows
# req.secure and X-Forwarded-Proto (Express trust proxy is set to 1). Set SESSION_COOKIE_SECURE=false if the
# browser drops the cookie on plain HTTP behind a proxy that does not set forwarded TLS headers.
# SESSION_COOKIE_SECURE=

# --- OAuth and single sign-on (optional) ---
#
# For each identity provider, create an OAuth application and set the authorized redirect URL to exactly:
#   {CLIENT_ORIGIN}/api/auth/oauth/google/callback
#   {CLIENT_ORIGIN}/api/auth/oauth/github/callback
#   {CLIENT_ORIGIN}/api/auth/oauth/gitlab/callback
#   {CLIENT_ORIGIN}/api/auth/oauth/microsoft/callback
#
# Replace {CLIENT_ORIGIN} with the same value as CLIENT_ORIGIN above, for example:
#   http://localhost:5173/api/auth/oauth/google/callback
#
# Optional: base URL for a self-hosted GitLab instance (defaults to https://gitlab.com if unset).
# OAUTH_GITLAB_BASE_URL=https://gitlab.com
#
# Optional: Microsoft Entra (Azure AD) tenant identifier (defaults to "common" for multi-tenant if unset).
# OAUTH_MICROSOFT_TENANT=common
#
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITLAB_CLIENT_ID=
# OAUTH_GITLAB_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=

# --- Plaid bank sync (optional) ---
# Create a Plaid developer account and use Sandbox for local testing.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# Optional: dedicated key for encrypting stored bank access tokens at rest.
# If unset, JWT_SECRET is used to derive the encryption key.
# BANK_TOKEN_ENCRYPTION_KEY=
# sandbox | production
# PLAID_ENV=sandbox
# Comma-separated ISO country codes for Link (default US).
# PLAID_COUNTRY_CODES=US

# --- OpenAI (optional: import AI category suggestions) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Mailgun (optional: transactional email notifications) ---
# Create a Mailgun account and add/verify your sending domain.
# When MAILGUN_API_KEY is unset, all email sending is silently skipped.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_REGION=us
# MAILGUN_SMTP_USER=postmaster@mg.example.com
# MAILGUN_SMTP_PASS=
# MAIL_FROM_ADDRESS=noreply@mg.example.com
# MAIL_FROM_NAME=UrExpense
